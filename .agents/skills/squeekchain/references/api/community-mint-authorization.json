{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chainId": {
      "type": "integer",
      "exclusiveMinimum": 0
    },
    "authMinter": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "authorizationId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|[+-]\\d{2}:?\\d{2})$"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{130}$"
    },
    "tier": {
      "type": "string",
      "enum": [
        "gold",
        "silver",
        "bronze",
        "member",
        "none"
      ]
    }
  },
  "required": [
    "chainId",
    "authMinter",
    "recipient",
    "quantity",
    "authorizationId",
    "deadline",
    "expiresAt",
    "signature",
    "tier"
  ],
  "additionalProperties": false,
  "$defs": {},
  "$comment": "Public structure generated from current packages/module-contracts. See endpoint notes for semantic constraints."
}
